# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (Postgres — Neon/Supabase/local). SSL required in production. ---
DATABASE_URL=postgresql://user:password@localhost:5432/dyners?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-bytes-hex
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Initial admin (used by the seed script only) ---
ADMIN_EMAIL=info@hcsolutions.rw
ADMIN_PASSWORD=change-me-strong-password

# --- CORS (comma-separated allowlist) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dyners.rw,https://www.dyners.rw

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (contact form notifications) ---
# Primary: Gmail SMTP. Requires 2-Step Verification on the Google account,
# then create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Fallback: Resend (used only when Gmail is unconfigured or fails)
RESEND_API_KEY=
# Inbox that receives the enquiries
CONTACT_TO_EMAIL=dyners@gmail.com
